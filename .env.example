# Copy this file to ".env" and paste your own Gemini API key.
# Get a key at: https://aistudio.google.com/app/apikey
# Never commit the real .env file (it is already in .gitignore).
GEMINI_API_KEY=your_key_here

# Optional: signs the session cookie that keeps each visitor's learning path
# isolated. If unset, a random key is generated on every server start (fine
# for local dev, but it means existing sessions are invalidated on restart).
FLASK_SECRET_KEY=your_own_random_string_here
